{
  "area": {
    "headless": {
      "id": "headless",
      "widgets": {
        "accessible-recorder": {
          "comp": "accessible-wxcc-widget",
          "script": "https://slurpas.github.io/accessible-wxcc-widget/accessible-wxcc-widget/accessible-wxcc-widget.js",
          "attributes": {
            "mode": "recorder"
          },
          "properties": {
            "taskMap": "$STORE.agentContact.taskMap"
          }
        }
      },
      "layout": {
        "areas": [["accessible-recorder"]],
        "size": {
          "cols": [1],
          "rows": [1]
        }
      }
    },
    "navigation": [
      {
        "nav": {
          "label": "My Status",
          "icon": "stored-info",
          "iconType": "momentumDesign",
          "navigateTo": "accessible-agent",
          "align": "top",
          "isDefaultLandingPage": true
        },
        "page": {
          "id": "accessible-agent",
          "widgets": {
            "accessible-widget": {
              "comp": "accessible-wxcc-widget",
              "script": "https://slurpas.github.io/accessible-wxcc-widget/accessible-wxcc-widget/accessible-wxcc-widget.js",
              "attributes": {
                "team-dashboard": "true",
                "team-refresh-seconds": "30",
                "call-history": "true"
              },
              "properties": {
                "agentId": "$STORE.agent.agentId",
                "teamId": "$STORE.agent.teamId",
                "channelsStatesMap": "$STORE.agent.channelsStatesMap",
                "taskMap": "$STORE.agentContact.taskMap",
                "isOutboundEnabledForAgent": "$STORE.agent.isOutboundEnabledForAgent",
                "isOutboundEnabledForTenant": "$STORE.agent.isOutboundEnabledForTenant",
                "outDialEp": "$STORE.agent.outDialEp"
              },
              "wrapper": {
                "title": "My Status",
                "maximizeAreaName": "app-maximize-area"
              }
            }
          },
          "layout": {
            "areas": [["accessible-widget"]],
            "size": {
              "cols": [1],
              "rows": [1]
            }
          }
        }
      }
    ]
  }
}
