{
  "name": "accessible-wxcc-widget",
  "version": "1.0.0",
  "private": true,
  "description": "High-contrast, screen-reader friendly agent widget for Cisco Webex Contact Center Desktop.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "preview": "vite preview --config vite.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm test && npm run build && node scripts/verify-bundle.mjs"
  },
  "dependencies": {
    "@wxcc-desktop/sdk": "3.0.1"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
